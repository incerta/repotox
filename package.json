{
  "name": "repotox",
  "version": "0.0.8",
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "formatter:fix": "prettier --write .",
    "formatter:check": "prettier --check . || (echo \"ERROR: use `npm run formatter:fix`\" && exit 1)",
    "ts": "tsc -p tests/tsconfig.json",
    "check": "npm run formatter:check && npm run ts && npm run test & npm run test:coverage",
    "publish:alpha": "bash scripts/publish-alpha.sh"
  },
  "peerDependencies": {
    "mongodb": "^6.21.0",
    "schematox": "^2.0.0-alpha.1784914313",
    "typescript": ">=5.3.2"
  },
  "devDependencies": {
    "mongodb": "^6.21.0",
    "prettier": "^3.1.1",
    "schematox": "^2.0.0-alpha.1784914313",
    "typescript": "^5.3.2",
    "vitest": "^3.2.6"
  },
  "description": "Maps schematox schemas to typed mongodb collections",
  "author": "Kanstantsin Mazur",
  "license": "MIT",
  "keywords": [
    "typescript",
    "schematox",
    "mongodb"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/incerta/repotox.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  }
}
