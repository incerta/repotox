{
  "name": "repotox",
  "version": "0.0.8",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "formatter:fix": "prettier --write .",
    "formatter:check": "prettier --check . || (echo \"ERROR: use `npm run formatter:fix`\" && exit 1)",
    "ts": "tsc --noEmit",
    "check": "npm run formatter:check && npm run ts && npm run test & npm run test:coverage",
    "publish:alpha": "bash scripts/publish-alpha.sh"
  },
  "peerDependencies": {
    "mongodb": "^6.8.0",
    "schematox": "^1.3.0",
    "typescript": ">=5.3.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.1",
    "jest": "^29.5.0",
    "mongodb": "^6.9.0",
    "prettier": "^3.1.1",
    "schematox": "^1.3.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.2"
  },
  "description": "Lightweight schematox schema based ORM for mongodb driver",
  "author": "Kanstantsin Mazur",
  "license": "MIT",
  "keywords": [
    "typescript",
    "schematox",
    "mongodb",
    "ODM",
    "ORM"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/incerta/repotox.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  }
}
